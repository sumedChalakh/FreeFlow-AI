# FreeFlow AI — example environment variables (placeholders only).
# Copy to `.env` locally. Never commit real secrets.
# Last updated: 2026-10-29T15:14:00+05:30
#
# These names are proposed. Finalize during Phase 1 configuration design.
# Do not treat this file as evidence that the application exists.

# Bind to loopback by default. Do not set 0.0.0.0 for the MVP without a security review.
FREEFLOW_API_HOST=127.0.0.1
FREEFLOW_API_PORT=8787

# Local API token for dashboard and compatible clients. Generate a random value locally.
FREEFLOW_API_TOKEN=replace-with-a-long-random-token

# SQLite path (relative to the backend working directory once implementation exists).
FREEFLOW_DATABASE_PATH=./data/freeflow.db

# Log level: DEBUG, INFO, WARNING, ERROR
FREEFLOW_LOG_LEVEL=INFO

# Provider credentials belong in the secure store once implemented.
# Do not put live API keys in this file. Example names only:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
