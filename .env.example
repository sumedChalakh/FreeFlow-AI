# ==============================================================================
# FreeFlow AI — Example Environment Configuration (Placeholders Only)
# ==============================================================================
# Copy this file to `.env` in the project root and customize locally.
# Never commit `.env` or real API credentials to Git history.
#
# All variables use the FREEFLOW_ prefix and correspond to Settings in backend/config.py.

# Server Binding
# Bind to loopback (127.0.0.1) by default for local-first security.
# Inside a Docker container, the app binds to 0.0.0.0, but the host port mapping
# must still be published only to 127.0.0.1 on the host (-p 127.0.0.1:8000:8000).
FREEFLOW_API_HOST=127.0.0.1
FREEFLOW_API_PORT=8000

# Authentication Token
# Required for OpenAI v1 (/v1/chat/completions, /v1/models) and Management (/api) routes.
# Generate a secure random token locally (e.g. `openssl rand -hex 24` or Python `secrets.token_hex(24)`).
FREEFLOW_API_TOKEN=change-this-to-a-secure-random-token

# SQLite Persistence Path
# Path to the SQLite database file. Defaults to `freeflow.db` in project root.
# In Docker deployments, set to `/data/freeflow.db` and mount a volume at `/data`.
FREEFLOW_DB_PATH=freeflow.db

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
FREEFLOW_LOG_LEVEL=INFO

# Ollama Endpoint Configuration
# Default local Ollama REST API endpoint.
# Host installation: http://127.0.0.1:11434
# Docker Desktop on Windows/macOS: http://host.docker.internal:11434
# Docker on Linux: http://host.docker.internal:11434 (with host-gateway) or http://172.17.0.1:11434
FREEFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
